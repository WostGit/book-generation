{
  "name": "baseline-enterprise-rag",
  "components": {
    "model": "models/qwen2.5-7b-instruct.json",
    "embedding": "embeddings/bge-large.json",
    "reranker": "rerankers/bge-reranker.json",
    "retriever": "retrievers/hybrid-faiss.json",
    "prompt": "prompts/epic-fantasy.json"
  },
  "scenario": {
    "genre": "fantasy",
    "chapter_count": 5,
    "subchapters_per_chapter": 10
  },
  "outputs": {
    "formats": [
      "md",
      "txt",
      "html",
      "docx",
      "odt",
      "epub",
      "pdf",
      "rtf",
      "fb2"
    ],
    "validators": [
      "strict-suite"
    ]
  },
  "rag_sources": [
    {
      "kind": "style_guide",
      "path": "data/rag/style-guide.txt",
      "weight": 1.0
    },
    {
      "kind": "lore_bible",
      "path": "data/rag/lore-bible.txt",
      "weight": 1.2
    }
  ]
}